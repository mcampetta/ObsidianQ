+    _reserved:                      [u8; 488],  // 536 â†’ 1024 total
 }
 
 impl FspFsctlVolumeParams {
@@ -216,7 +216,7 @@ pub type RenameFn             = unsafe extern "system" fn(*mut FspFileSystem, PV
